# Every variable the app reads. Keep this file in sync — it is the checklist for a new environment.
# Real values go in .env.local, which is gitignored and never committed.

# --- Database (Neon) -------------------------------------------------------
# Neon dashboard -> your project -> Connection string. Use the POOLED string.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Auth (Better Auth) ----------------------------------------------------
# Generated with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The app's own origin. http://localhost:3000 in dev, the deployed origin in production.
BETTER_AUTH_URL="http://localhost:3000"

# github.com/settings/developers -> New OAuth App
# Authorization callback URL must be exactly: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# console.cloud.google.com -> Credentials -> OAuth client ID -> Web application
# Authorized redirect URI must be exactly: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- LLM (any OpenAI-compatible endpoint) ----------------------------------
# Needed from Step 4. The provider is configured only by these three variables,
# so the model can be swapped without touching code.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# --- Sandbox (Step 6 stretch only) -----------------------------------------
E2B_API_KEY=""
